# Copy to .env and adjust. .env is gitignored; this file is committed.

# --- App ---
PORT=9000

# --- MongoDB ---
# Credentials below must match what docker-compose.yml provisions.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=example
MONGO_DATABASE=civicon
MONGO_PORT=27017

# authSource=admin is required because the root user lives in the admin
# database, not in MONGO_DATABASE.
MONGODB_URI=mongodb://root:example@localhost:27017/civicon?authSource=admin
