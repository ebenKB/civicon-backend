# Copy to .env and adjust. .env is gitignored; this file is committed.

# --- App ---
PORT=9000

# --- MongoDB ---
# These are the single source of truth for local development: docker-compose
# provisions the container with them, and the app composes its connection URI
# from the same values (see src/config/database.config.ts). Change a password
# here and both sides stay in sync.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=example
MONGO_DATABASE=civicon
# 127.0.0.1 rather than "localhost": Node resolves localhost to ::1 first, so
# the driver takes Docker Desktop's IPv6 forwarding path when IPv4 is right
# there. Pinning it removes one layer of indirection. "localhost" also works.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
# The root user provisioned by the container lives in the admin database.
MONGO_AUTH_SOURCE=admin

# Optional full-URI override, for hosted deployments where the provider issues
# the connection string as a whole (Atlas, replica sets). When set, it wins and
# the MONGO_* values above are ignored by the app.
# MONGODB_URI=mongodb+srv://user:password@cluster.example.net/civicon

# Used only by `npm run test:e2e`, and only when MONGODB_URI is set above.
# Must point at a throwaway database whose name ends in "_test" — the suite
# truncates collections.
# MONGODB_URI_TEST=mongodb+srv://user:password@cluster.example.net/civicon_test

# --- Auth ---
# No default is provided on purpose: a fallback development secret is exactly
# the secret that reaches production. The app refuses to boot without this.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional. bcrypt work factor; defaults to 12.
# The test suites set this to 4 themselves — at 12 a single hash costs about a
# second, which is fine for a login and punishing for a few hundred of them.
# Outside NODE_ENV=test the floor is 10, so a stray low value here cannot
# weaken a deployment. Leave it unset.
# BCRYPT_COST=12
