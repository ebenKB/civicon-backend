              }
            }
          ]
        },
        {
          "name": "Hello",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/hello",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "hello"
              ]
            },
            "description": "Marked @Public() in hello.controller.ts.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Sign-up and sign-in. Both register and login return { token, user }; the token's claims carry the user's roles, so guards need no database round-trip.\n\nLogin and register write `token` and `user_id` into the collection variables, so every later request is authenticated automatically.",
      "item": [
        {
          "name": "Register \u2014 citizen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Omitting `roles` defaults to [CITIZEN].\n\nThe email carries a random suffix so the collection can be re-run: the seed already owns the fixed addresses, and a duplicate returns 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada-{{$randomUUID}}@example.com\",\n  \"password\": \"super-secret\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('returns a token and a user', () => {",
                  "  pm.expect(json.token).to.be.a('string');",
                  "  pm.expect(json.user).to.be.an('object');",
                  "});",
                  "pm.test('never leaks the password hash', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('passwordHash');",
                  "});",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.collectionVariables.set('user_id', json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register \u2014 volunteer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Asking for VOLUNTEER alone is normalized to [VOLUNTEER, CITIZEN]: a volunteer is a citizen who also does the work, so there is no actor who can fix a problem but not report one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kofi Mensah\",\n  \"email\": \"kofi-{{$randomUUID}}@example.com\",\n  \"password\": \"super-secret\",\n  \"roles\": [\n    \"VOLUNTEER\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('VOLUNTEER implies CITIZEN', () => {",
                  "  pm.expect(json.user.roles).to.have.members(['VOLUNTEER', 'CITIZEN']);",
                  "});",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.collectionVariables.set('user_id', json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Returns 200 (not 201) \u2014 signing in creates no resource.\n\nUses the seeded volunteer account. Run `npm run seed` first.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"volunteer@civicon.test\",\n  \"password\": \"{{demo_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('returns a token and a user', () => {",
                  "  pm.expect(json.token).to.be.a('string');",
                  "  pm.expect(json.user).to.be.an('object');",
                  "});",
                  "pm.test('never leaks the password hash', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('passwordHash');",
                  "});",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.collectionVariables.set('user_id', json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Re-reads the database, so the roles returned are authoritative even when the bearer's token was issued before an admin changed them. This is how a client picks up a role change without signing in again."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports the caller kind', () => {",
                  "  pm.expect(pm.response.json().roles).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users (admin only)",
      "description": "User administration, restricted to ADMIN. There is no POST /users \u2014 registration is the only account-creation path, since a second one would produce users with no password.\n\nThis folder is self-contained: it signs in as the seeded admin, creates a disposable user to operate on, and deletes it at the end. Safe to run end-to-end.",
      "item": [
        {
          "name": "Sign in as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Seeded by `npm run seed`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@civicon.test\",\n  \"password\": \"{{demo_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('is an admin', () => pm.expect(json.user.roles).to.include('ADMIN'));",
                  "pm.collectionVariables.set('token', json.token);",
                  "pm.collectionVariables.set('admin_token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a disposable user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registered with a random email so the folder can be re-run. Its id lands in `target_user_id`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Disposable\",\n  \"email\": \"disposable-{{$randomUUID}}@example.com\",\n  \"password\": \"super-secret\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('responds 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('target_user_id', json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Requires ADMIN. The password hash is absent from every response: the schema marks it `select: false` and the toJSON transform deletes it.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('never leaks the password hash', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('passwordHash');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/{{target_user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{target_user_id}}"
              ]
            },
            "description": "A malformed id returns 400 (not 500) via ParseObjectIdPipe; a well-formed but unknown id returns 404.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update a user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{target_user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{target_user_id}}"
              ]
            },
            "description": "UpdateUserDto carries no `roles` field, so this route cannot be used to escalate privileges \u2014 see the Guardrails folder.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Renamed By Admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Grant roles",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{target_user_id}}/roles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{target_user_id}}",
                "roles"
              ]
            },
            "description": "The admin-only path by which AGENCY, SPONSOR and ADMIN accounts come into existence.\n\nReplace semantics: the array supplied becomes the user's roles, so this revokes as well as grants. AGENCY implies nothing, so CITIZEN is dropped here.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\n    \"AGENCY\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.test('replaces rather than merges', () => {",
                  "  pm.expect(pm.response.json().roles).to.eql(['AGENCY']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete the disposable user",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/{{target_user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{target_user_id}}"
              ]
            },
            "description": "Returns 204 No Content.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Guardrails",
      "description": "Every one of these is enforced server-side, not by hiding a control in a UI. Run this folder as a security regression suite \u2014 all requests assert their status code.",
      "item": [
        {
          "name": "Sign in as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "This folder is self-contained, so it obtains its own tokens rather than depending on the folders above.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@civicon.test\",\n  \"password\": \"{{demo_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('admin_token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as citizen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Captures a non-privileged token for the 403 checks below, and a user id for the escalation attempts.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@civicon.test\",\n  \"password\": \"{{demo_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('responds 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('citizen_token', json.token);",
                  "pm.collectionVariables.set('user_id', json.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cannot self-assign ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Rejected at the DTO, before any service code runs. Agencies are the authoritative owners of issues, so that authority cannot be claimed by anyone who can reach the signup form.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mallory\",\n  \"email\": \"mallory@example.com\",\n  \"password\": \"super-secret\",\n  \"roles\": [\n    \"ADMIN\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 400', () => pm.response.to.have.status(400));",
                  "pm.test('names the offending field', () => {",
                  "  pm.expect(JSON.stringify(pm.response.json().message)).to.include('roles');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cannot self-assign AGENCY",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Same gate. Only CITIZEN and VOLUNTEER are self-serve.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mallory\",\n  \"email\": \"mallory2@example.com\",\n  \"password\": \"super-secret\",\n  \"roles\": [\n    \"AGENCY\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "No token is 401",
          "request": {
            "method": "GET",
            "header": [],
